# Configuracoes de Seguranca e Ambiente
DJANGO_SECRET_KEY=ds-state-of-the-art-production-key-998877665544332211
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Banco de Dados PostgreSQL (Altere conforme suas credenciais locais)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/datascience_db
# Caso queira testar imediatamente sem o servico PostgreSQL ativo, mude para False abaixo:
USE_POSTGRES=False

# Configuracao de E-mail Profissional Real (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email_profissional@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_smtp
DEFAULT_FROM_EMAIL=Plataforma Data Science <seu_email_profissional@gmail.com>

# OAuth2 Credenciais (Google & GitHub)
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GITHUB_CLIENT_ID=seu-github-client-id
GITHUB_CLIENT_SECRET=seu-github-client-secret
